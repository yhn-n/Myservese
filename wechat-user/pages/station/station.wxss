.station-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 140rpx;
}

.station-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  background: #fff;
  margin-bottom: 16rpx;
}

.station-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.station-status {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.station-status.open {
  background: #e6f7e6;
  color: #52c41a;
}

.station-status.closed {
  background: #fff1f0;
  color: #ff4d4f;
}

.info-card {
  background: #fff;
  padding: 24rpx 32rpx;
  margin-bottom: 16rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #999;
}

.info-value {
  font-size: 28rpx;
  color: #333;
}

.info-value.highlight {
  color: #6B7FFF;
  font-weight: bold;
}

.charger-section {
  background: #fff;
  padding: 24rpx 32rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 20rpx;
}

.charger-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.charger-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.charger-no {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

.charger-type {
  font-size: 24rpx;
  color: #666;
}

.charger-power {
  font-size: 24rpx;
  color: #6B7FFF;
}

.charger-price {
  font-size: 24rpx;
  color: #000;
  font-weight: bold;
}

.charger-status {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
}

.status-0 { background: #f5f5f5; color: #999; }
.status-1 { background: #e6f7e6; color: #52c41a; }
.status-2 { background: #f0f2ff; color: #6B7FFF; }
.status-3 { background: #fff1f0; color: #ff4d4f; }

.empty-tip {
  text-align: center;
  padding: 40rpx 0;
  color: #999;
  font-size: 28rpx;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.05);
  gap: 20rpx;
}

.nav-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 30rpx;
  background: #f5f5f5;
  color: #333;
  border: none;
}

.nav-btn::after { border: none; }

.charge-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 30rpx;
  background: #6B7FFF;
  color: #fff;
  border: none;
}

.charge-btn::after { border: none; }
