<view class="notice-page">
  <scroll-view scroll-y class="notice-list" bindscrolltolower="loadMore">
    <view class="notice-card" wx:for="{{notices}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <view class="notice-header">
        <text class="notice-title">{{item.title}}</text>
        <text class="notice-time">{{item.createTime}}</text>
      </view>
      <text class="notice-summary">{{item.content}}</text>
    </view>

    <view class="empty-tip" wx:if="{{notices.length === 0}}">
      <text>暂无公告</text>
    </view>

    <view class="load-more" wx:if="{{notices.length > 0 && !hasMore}}">
      <text>没有更多了</text>
    </view>
  </scroll-view>
</view>
