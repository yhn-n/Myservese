.notice-page {
  min-height: 100vh;
  background: #f5f5f5;
}

.notice-list {
  height: 100vh;
  padding: 16rpx 24rpx;
}

.notice-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.notice-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.notice-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
  margin-right: 16rpx;
}

.notice-time {
  font-size: 24rpx;
  color: #999;
  flex-shrink: 0;
}

.notice-summary {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.empty-tip {
  text-align: center;
  padding: 120rpx 0;
  color: #999;
  font-size: 28rpx;
}

.load-more {
  text-align: center;
  padding: 24rpx 0;
  color: #999;
  font-size: 24rpx;
}
