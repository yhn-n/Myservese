.detail-page {
  min-height: 100vh;
  background: #fff;
  padding: 32rpx;
}

.notice-header {
  margin-bottom: 32rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.notice-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
}

.notice-time {
  font-size: 24rpx;
  color: #999;
}

.notice-body {
  padding: 0 8rpx;
}

.notice-content {
  font-size: 30rpx;
  color: #333;
  line-height: 1.8;
  white-space: pre-wrap;
}
