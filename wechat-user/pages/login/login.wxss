.login-page {
  min-height: 100vh;
  background: #111111;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 48rpx;
  position: relative;
  overflow: hidden;
}

/* 返回按钮 */
.back-btn {
  position: fixed;
  top: 80rpx;
  left: 32rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
}

.back-btn:active {
  background: rgba(255, 255, 255, 0.25);
}

.back-icon {
  font-size: 36rpx;
  color: #fff;
  font-weight: bold;
}

/* 顶部装饰 */
.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 70%;
  pointer-events: none;
}

.bg-circle {
  position: absolute;
  border-radius: 50%;
  filter: blur(60rpx);
}

.bg-circle-1 {
  width: 520rpx;
  height: 520rpx;
  background: rgba(60, 60, 70, 0.45);
  top: -180rpx;
  right: -160rpx;
}

.bg-circle-2 {
  width: 420rpx;
  height: 420rpx;
  background: rgba(40, 40, 50, 0.5);
  top: 240rpx;
  left: -200rpx;
}

/* Logo */
.logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 180rpx;
  margin-bottom: 80rpx;
  position: relative;
  z-index: 1;
}

.logo-wrapper {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 36rpx;
}

.logo-box {
  width: 160rpx;
  height: 160rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #6B7FFF 0%, #4A5FD9 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 1;
  box-shadow: 0 16rpx 48rpx rgba(75, 95, 217, 0.35);
}

.logo-inner {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.12);
}

.logo-glow {
  position: absolute;
  width: 160rpx;
  height: 160rpx;
  border-radius: 40rpx;
  background: rgba(107, 127, 255, 0.45);
  top: 14rpx;
  left: 14rpx;
  filter: blur(28rpx);
  z-index: 0;
}

.app-name {
  font-size: 46rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 14rpx;
  letter-spacing: 4rpx;
}

.app-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.55);
  letter-spacing: 2rpx;
}

/* 表单卡片 */
.form-card {
  width: 100%;
  background: #fff;
  border-radius: 36rpx 36rpx 0 0;
  padding: 52rpx 44rpx 60rpx;
  position: relative;
  z-index: 1;
  margin-top: auto;
  margin-left: -48rpx;
  margin-right: -48rpx;
  width: calc(100% + 96rpx);
}

/* Tab 切换 */
.tab-bar {
  display: flex;
  margin-bottom: 52rpx;
  padding: 0 40rpx;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: 18rpx;
  position: relative;
}

.tab-item text {
  font-size: 34rpx;
  color: #999;
  font-weight: 500;
  transition: color 0.3s;
}

.tab-active text {
  color: #111;
  font-weight: 700;
}

.tab-line {
  width: 56rpx;
  height: 6rpx;
  background: #111;
  border-radius: 3rpx;
  margin-top: 14rpx;
}

/* 输入框 */
.input-group {
  display: flex;
  align-items: center;
  height: 100rpx;
  border: 2rpx solid #f0f0f0;
  border-radius: 18rpx;
  padding: 0 28rpx;
  margin-bottom: 28rpx;
  background: #f8f8f8;
  transition: all 0.3s ease;
}

.input-group.input-focus {
  border-color: #111;
  background: #fff;
}

.input-icon {
  font-size: 32rpx;
  margin-right: 18rpx;
  color: #999;
}

.input {
  flex: 1;
  height: 100%;
  font-size: 30rpx;
  color: #111;
  background: transparent;
}

.input::placeholder {
  color: #bbb;
}

.input-clear {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 12rpx;
}

.icon-clear {
  font-size: 22rpx;
  color: #fff;
  background: #d0d0d0;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 34rpx;
  text-align: center;
}

.input-eye {
  margin-left: 12rpx;
  font-size: 30rpx;
  color: #999;
}

/* 注册额外输入框间距 */
.input-group-extra {
  margin-bottom: 28rpx;
}

/* 登录/注册按钮 */
.login-btn {
  width: 100%;
  height: 100rpx;
  background: #111;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  letter-spacing: 8rpx;
  margin-top: 16rpx;
  margin-bottom: 44rpx;
}

.login-btn::after {
  border: none;
}

.login-btn[disabled] {
  opacity: 0.5;
}

/* 分割线 */
.divider {
  display: flex;
  align-items: center;
  margin-bottom: 36rpx;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: #eee;
}

.divider-text {
  font-size: 22rpx;
  color: #bbb;
  padding: 0 20rpx;
}

/* 快捷登录 */
.quick-login {
  display: flex;
  justify-content: center;
}

.quick-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 40rpx;
}

.wx-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #111;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 10rpx;
}

.wx-icon text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 700;
}

.quick-label {
  font-size: 20rpx;
  color: #999;
}

/* 协议 */
.agreement-area {
  margin-top: 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  z-index: 1;
}

.agreement-check {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.checkbox {
  width: 28rpx;
  height: 28rpx;
  border: 2rpx solid #ccc;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 8rpx;
  transition: all 0.2s ease;
}

.checkbox.checked {
  background: #111;
  border-color: #111;
}

.checkbox text {
  font-size: 18rpx;
  color: #fff;
}

.agree-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
}

.agreement-links {
  display: flex;
  align-items: center;
}

.link {
  font-size: 22rpx;
  color: #fff;
  font-weight: 500;
}

.and-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.4);
  margin: 0 4rpx;
}

/* 底部 */
.footer-tip {
  margin-top: 24rpx;
  padding-bottom: 48rpx;
  position: relative;
  z-index: 1;
}

.footer-tip text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.45);
}

.footer-link {
  color: #fff;
  font-weight: 500;
}
