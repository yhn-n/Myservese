<view class="feedback-page">
  <!-- 反馈表单 -->
  <view class="form-section">
    <view class="form-item">
      <text class="form-label">反馈类型</text>
      <picker mode="selector" range="{{types}}" range-key="label" value="{{typeIndex}}" bindchange="onTypeChange">
        <view class="picker-value">
          <text>{{types[typeIndex].label || '请选择反馈类型'}}</text>
          <text class="arrow">></text>
        </view>
      </picker>
    </view>

    <view class="form-item">
      <text class="form-label">关联站点</text>
      <picker mode="selector" range="{{stations}}" range-key="name" value="{{stationIndex}}" bindchange="onStationChange">
        <view class="picker-value">
          <text>{{stations[stationIndex].name || '请选择站点（可选）'}}</text>
          <text class="arrow">></text>
        </view>
      </picker>
    </view>

    <view class="form-item textarea-item">
      <text class="form-label">反馈内容</text>
      <textarea class="form-textarea" placeholder="请详细描述您遇到的问题"
                value="{{content}}" bindinput="onContentInput" maxlength="500" />
      <text class="char-count">{{content.length}}/500</text>
    </view>

    <view class="form-item">
      <text class="form-label">上传图片（可选）</text>
      <view class="image-list">
        <view class="image-item" wx:for="{{images}}" wx:key="*this">
          <image src="{{item}}" mode="aspectFill" bindtap="previewImage" data-url="{{item}}"></image>
          <view class="delete-btn" catchtap="deleteImage" data-index="{{index}}">x</view>
        </view>
        <view class="add-image" wx:if="{{images.length < 3}}" bindtap="chooseImage">
          <text class="add-icon">+</text>
          <text class="add-text">添加图片</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 提交按钮 -->
  <view class="submit-area">
    <button class="submit-btn" bindtap="submitFeedback" loading="{{loading}}">提交反馈</button>
  </view>

  <!-- 历史反馈 -->
  <view class="history-section" wx:if="{{feedbacks.length > 0}}">
    <text class="section-title">我的反馈</text>
    <view class="feedback-item" wx:for="{{feedbacks}}" wx:key="id">
      <view class="feedback-header">
        <text class="feedback-time">{{item.createTime}}</text>
        <text class="feedback-status status-{{item.status}}">
          {{item.status === 0 ? '待处理' : item.status === 1 ? '处理中' : '已解决'}}
        </text>
      </view>
      <text class="feedback-content">{{item.content}}</text>
      <view class="feedback-reply" wx:if="{{item.reply}}">
        <text class="reply-label">官方回复：</text>
        <text class="reply-content">{{item.reply}}</text>
      </view>
    </view>
  </view>
</view>
