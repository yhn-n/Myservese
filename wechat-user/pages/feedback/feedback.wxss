.feedback-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

.form-section {
  background: #fff;
  margin: 16rpx 24rpx;
  border-radius: 16rpx;
  padding: 24rpx;
}

.form-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
}

.picker-value {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  color: #666;
}

.arrow {
  color: #ccc;
}

.textarea-item {
  position: relative;
}

.form-textarea {
  width: 100%;
  height: 200rpx;
  font-size: 28rpx;
  padding: 16rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  box-sizing: border-box;
}

.char-count {
  position: absolute;
  right: 16rpx;
  bottom: 24rpx;
  font-size: 22rpx;
  color: #999;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  overflow: hidden;
  position: relative;
}

.image-item image {
  width: 100%;
  height: 100%;
}

.delete-btn {
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-image {
  width: 160rpx;
  height: 160rpx;
  border: 2rpx dashed #ccc;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.add-icon {
  font-size: 48rpx;
  color: #999;
}

.add-text {
  font-size: 22rpx;
  color: #999;
}

.submit-area {
  padding: 24rpx;
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: #6B7FFF;
  color: #fff;
  font-size: 32rpx;
  border-radius: 12rpx;
  border: none;
}

.submit-btn::after { border: none; }

.history-section {
  background: #fff;
  margin: 16rpx 24rpx;
  border-radius: 16rpx;
  padding: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
}

.feedback-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.feedback-item:last-child {
  border-bottom: none;
}

.feedback-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.feedback-time {
  font-size: 24rpx;
  color: #999;
}

.feedback-status {
  font-size: 24rpx;
}

.status-0 { color: #faad14; }
.status-1 { color: #6B7FFF; }
.status-2 { color: #52c41a; }

.feedback-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

.feedback-reply {
  margin-top: 12rpx;
  padding: 16rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
}

.reply-label {
  font-size: 24rpx;
  color: #6B7FFF;
  font-weight: bold;
}

.reply-content {
  font-size: 24rpx;
  color: #666;
}
