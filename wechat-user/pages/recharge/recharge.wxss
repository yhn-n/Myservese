.recharge-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 140rpx;
}

.balance-card {
  background: linear-gradient(135deg, #1a1a2e, #16213e);
  padding: 60rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.balance-label {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 16rpx;
}

.balance-value {
  font-size: 72rpx;
  color: #fff;
  font-weight: bold;
}

.amount-section {
  background: #fff;
  margin: 24rpx;
  border-radius: 16rpx;
  padding: 32rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 24rpx;
}

.amount-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.amount-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 120rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  position: relative;
}

.amount-item.selected {
  border-color: #6B7FFF;
  background: #f0f2ff;
}

.amount-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.amount-desc {
  font-size: 20rpx;
  color: #000;
  position: absolute;
  top: 8rpx;
  right: 8rpx;
}

.custom-amount {
  margin-top: 32rpx;
}

.custom-label {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-bottom: 16rpx;
}

.custom-input {
  width: 100%;
  height: 88rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
}

.recharge-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: #6B7FFF;
  color: #fff;
  font-size: 32rpx;
  border-radius: 12rpx;
  border: none;
}

.recharge-btn::after { border: none; }
