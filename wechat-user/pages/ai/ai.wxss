.ai-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
}

.chat-area {
  flex: 1;
  padding: 24rpx;
}

.message-wrapper {
  margin-bottom: 24rpx;
  display: flex;
}

.message-wrapper.user {
  justify-content: flex-end;
}

.message-wrapper.assistant {
  justify-content: flex-start;
}

.message-bubble {
  max-width: 80%;
  padding: 20rpx 28rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.user .message-bubble {
  background: #6B7FFF;
  color: #fff;
  border-bottom-right-radius: 4rpx;
}

.assistant .message-bubble {
  background: #fff;
  color: #333;
  border-bottom-left-radius: 4rpx;
}

.message-bubble.loading {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.dot {
  font-size: 36rpx;
  animation: blink 1.4s infinite both;
}

.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes blink {
  0%, 80%, 100% { opacity: 0; }
  40% { opacity: 1; }
}

.quick-questions {
  margin-top: 24rpx;
}

.quick-title {
  font-size: 28rpx;
  color: #999;
  display: block;
  margin-bottom: 16rpx;
}

.quick-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  padding: 24rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  font-size: 28rpx;
  color: #333;
}

.quick-item .arrow {
  color: #ccc;
}

.input-area {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
}

.chat-input {
  flex: 1;
  height: 72rpx;
  background: #f5f5f5;
  border-radius: 36rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  margin-right: 16rpx;
}

.send-btn {
  width: 120rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: #6B7FFF;
  color: #fff;
  font-size: 28rpx;
  border-radius: 36rpx;
  border: none;
  flex-shrink: 0;
}

.send-btn::after { border: none; }
