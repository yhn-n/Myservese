<view class="ai-page">
  <!-- 聊天区域 -->
  <scroll-view scroll-y class="chat-area" scroll-into-view="{{scrollToId}}">
    <!-- 欢迎消息 -->
    <view class="message-wrapper assistant">
      <view class="message-bubble">
        <text>你好！我是新能源充电站AI客服助手，有什么可以帮助您的吗？\n\n我可以帮您解答：\n- 充电站位置和导航\n- 充电价格和计费规则\n- 充电流程和操作指导\n- 账户和订单问题</text>
      </view>
    </view>

    <!-- 快捷问题 -->
    <view class="quick-questions" wx:if="{{messages.length === 0}}">
      <text class="quick-title">常见问题</text>
      <view class="quick-item" wx:for="{{quickQuestions}}" wx:key="*this"
            bindtap="sendQuickQuestion" data-question="{{item}}">
        <text>{{item}}</text>
        <text class="arrow">></text>
      </view>
    </view>

    <!-- 聊天消息 -->
    <view class="message-wrapper {{item.role}}" wx:for="{{messages}}" wx:key="id"
          id="msg-{{item.id}}">
      <view class="message-bubble">
        <text>{{item.content}}</text>
      </view>
    </view>

    <!-- 加载中 -->
    <view class="message-wrapper assistant" wx:if="{{loading}}">
      <view class="message-bubble loading">
        <text class="dot">.</text>
        <text class="dot">.</text>
        <text class="dot">.</text>
      </view>
    </view>
  </scroll-view>

  <!-- 输入区域 -->
  <view class="input-area">
    <input class="chat-input" placeholder="请输入您的问题"
           value="{{inputValue}}" bindinput="onInput"
           bindconfirm="sendMessage" confirm-type="send" />
    <button class="send-btn" bindtap="sendMessage" disabled="{{!inputValue}}">发送</button>
  </view>
</view>
