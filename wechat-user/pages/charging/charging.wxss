.charging-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #1a1a2e 0%, #16213e 50%, #f5f5f5 50%);
  padding-bottom: 140rpx;
}

.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.loading-text {
  color: #fff;
  font-size: 32rpx;
  background: rgba(0, 0, 0, 0.6);
  padding: 24rpx 48rpx;
  border-radius: 12rpx;
}

.charging-visual {
  display: flex;
  justify-content: center;
  padding-top: 80rpx;
  padding-bottom: 60rpx;
}

.circle-bg {
  width: 400rpx;
  height: 400rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.circle-progress {
  position: absolute;
  width: 360rpx;
  height: 360rpx;
  border-radius: 50%;
  border: 8rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #fff;
}

.circle-center {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.charging-icon {
  font-size: 80rpx;
}

.charging-text {
  font-size: 32rpx;
  color: #fff;
  font-weight: bold;
  margin-top: 16rpx;
}

.info-card {
  background: #fff;
  margin: 0 32rpx;
  border-radius: 24rpx;
  padding: 24rpx 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #999;
}

.info-value {
  font-size: 28rpx;
  color: #333;
}

.info-value.highlight {
  color: #6B7FFF;
  font-weight: bold;
  font-size: 32rpx;
}

.info-value.cost {
  color: #000;
  font-weight: bold;
  font-size: 36rpx;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
}

.stop-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: #ff4d4f;
  color: #fff;
  font-size: 32rpx;
  border-radius: 12rpx;
  border: none;
}

.stop-btn::after { border: none; }
