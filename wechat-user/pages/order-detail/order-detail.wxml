<view class="detail-page" wx:if="{{order}}">
  <!-- 状态 -->
  <view class="status-section status-bg-{{order.status}}">
    <text class="status-icon">{{order.status === 1 ? '⚡' : order.status === 2 ? '✅' : '❌'}}</text>
    <text class="status-text">{{order.statusText}}</text>
  </view>

  <!-- 订单信息 -->
  <view class="info-card">
    <view class="card-title">订单信息</view>
    <view class="info-row">
      <text class="info-label">订单号</text>
      <text class="info-value">{{order.orderNo}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">站点</text>
      <text class="info-value">{{order.stationName}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">枪号</text>
      <text class="info-value">{{order.gunId}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">开始时间</text>
      <text class="info-value">{{order.startTime}}</text>
    </view>
    <view class="info-row" wx:if="{{order.endTime}}">
      <text class="info-label">结束时间</text>
      <text class="info-value">{{order.endTime}}</text>
    </view>
  </view>

  <!-- 费用信息 -->
  <view class="info-card">
    <view class="card-title">费用信息</view>
    <view class="amount-row">
      <text class="amount-label">充电费用</text>
      <text class="amount-value">¥{{order.totalAmount || '0.00'}}</text>
    </view>
  </view>

  <!-- 底部按钮 -->
  <view class="bottom-bar" wx:if="{{order.status === 1}}">
    <button class="finish-btn" bindtap="finishCharge">结束充电</button>
  </view>
</view>
