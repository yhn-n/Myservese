.search-page {
  min-height: 100vh;
  background: #f5f7fa;
}

/* 搜索头部 */
.search-header {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  height: 76rpx;
  background: #f5f7fa;
  border-radius: 38rpx;
  padding: 0 24rpx;
}

.search-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  color: #999;
}

.search-input {
  flex: 1;
  font-size: 30rpx;
  color: #333;
  height: 76rpx;
  line-height: 76rpx;
}

.placeholder {
  color: #bbb;
  font-size: 28rpx;
}

.clear-btn {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ddd;
  border-radius: 50%;
  margin-left: 12rpx;
}

.clear-icon {
  font-size: 22rpx;
  color: #fff;
}

.cancel-btn {
  font-size: 30rpx;
  color: #666;
  margin-left: 24rpx;
}

/* 搜索历史 */
.history-section {
  padding: 32rpx;
  background: #fff;
  margin-top: 16rpx;
}

.section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.clear-history {
  font-size: 26rpx;
  color: #999;
  font-weight: normal;
}

.history-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.history-item {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #f5f7fa;
  border-radius: 32rpx;
}

.history-icon {
  font-size: 24rpx;
  color: #999;
  margin-right: 8rpx;
}

.history-text {
  font-size: 28rpx;
  color: #666;
}

/* 搜索结果 */
.result-section {
  padding: 16rpx 24rpx;
}

.result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}

.result-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.result-count {
  font-size: 26rpx;
  color: #999;
}

.result-scroll {
  height: calc(100vh - 140rpx);
}

/* 充电站卡片 */
.station-card {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 28rpx;
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.station-main {
  flex: 1;
  min-width: 0;
}

.station-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.station-name {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.station-status {
  font-size: 24rpx;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  margin-left: 16rpx;
  white-space: nowrap;
}

.status-open {
  color: #52c41a;
  background: #f6ffed;
}

.status-closed {
  color: #ff4d4f;
  background: #fff1f0;
}

.station-address {
  font-size: 28rpx;
  color: #999;
  display: block;
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.station-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.tag {
  font-size: 24rpx;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
}

.tag-primary {
  color: #6B7FFF;
  background: #f0f2ff;
}

.tag-success {
  color: #52c41a;
  background: #f6ffed;
}

.tag-warning {
  color: #faad14;
  background: #fffbe6;
}

.station-price {
  display: flex;
  align-items: baseline;
}

.price-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #000;
}

.price-unit {
  font-size: 24rpx;
  color: #999;
  margin-left: 4rpx;
}

.station-distance {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 100rpx;
  margin-left: 24rpx;
  padding-left: 24rpx;
  border-left: 1rpx solid #f0f0f0;
}

.distance-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #6B7FFF;
}

.distance-unit {
  font-size: 24rpx;
  color: #999;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-title {
  font-size: 34rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #999;
}
